{
  "manifest_version": 3,
  "name": "TikTok 创作者作品归档助手",
  "short_name": "TikTok 归档助手",
  "version": "1.0",
  "description": "在 TikTok 个人主页/单视频/点赞/合集页旁挂一个采集面板：截获页面自身发出的作品接口，抓取视频/图集直链并批量下载。",
  "minimum_chrome_version": "111",

  "permissions": ["downloads", "storage", "unlimitedStorage", "tabs", "declarativeNetRequest", "declarativeNetRequestFeedback", "cookies", "alarms"],

  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.tiktokcdn-us.com/*",
    "*://*.tiktokcdn-eu.com/*",
    "*://*.tiktokv.com/*",
    "*://*.tiktokv.us/*",
    "*://*.muscdn.com/*",
    "*://*.ibyteimg.com/*",
    "*://*.byteoversea.com/*"
  ],

  "background": { "service_worker": "background.js" },

  "action": {
    "default_title": "TikTok 创作者作品归档助手",
    "default_popup": "popup.html"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tta_referer",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.tiktok.com/*"]
    }
  ],

  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
