{
  "manifest_version": 3,
  "name": "快手创作者作品归档助手",
  "short_name": "快手归档助手",
  "version": "1.4",
  "description": "在快手创作者主页旁挂一个采集面板：截获页面自身发出的作品接口，抓取视频/图集直链并批量下载；支持导入创作者列表连续归档。",
  "homepage_url": "https://github.com/cxy-251/PyGitRep001/tree/main/ExtensionForge/002KuaishouCreatorArchiver",
  "minimum_chrome_version": "111",

  "permissions": ["downloads", "storage", "unlimitedStorage", "tabs", "declarativeNetRequest"],

  "host_permissions": [
    "*://*.kuaishou.com/*",
    "*://*.chenzhongtech.com/*",
    "*://*.kwaicdn.com/*",
    "*://*.yximgs.com/*",
    "*://*.kwimgs.com/*",
    "*://*.ndcimgs.com/*",
    "*://*.oskwai.com/*",
    "*://*.djvod.com/*"
  ],

  "background": { "service_worker": "background.js" },

  "action": {
    "default_title": "快手创作者作品归档助手",
    "default_popup": "popup.html"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "kca_referer",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.kuaishou.com/*", "*://*.chenzhongtech.com/*"]
    }
  ],

  "content_scripts": [
    {
      "matches": ["*://*.kuaishou.com/*", "*://*.chenzhongtech.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.kuaishou.com/*", "*://*.chenzhongtech.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
